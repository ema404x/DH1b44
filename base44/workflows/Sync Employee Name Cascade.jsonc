{
  "name": "Sync Employee Name Cascade",
  "description": "Cuando se modifica el full_name de un Employee, propaga el cambio a todas las entidades con nombres denormalizados (WorkOrder, Pendiente, LocationData, Direccion, MovimientoPanol) y sincroniza el User de plataforma.",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"full_name\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Employee"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_employee_name_cascade",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sincronizarNombreEmpleado",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sincronizarNombreEmpleado"
  }
}