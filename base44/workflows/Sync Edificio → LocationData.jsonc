{
  "name": "Sync Edificio \u2192 LocationData",
  "description": "Al crear/editar un Edificio, sincroniza los campos compartidos hacia su LocationData vinculado (idempotente por diff-checking).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Edificio"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_edificio_locationdata",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sincronizarUbicaciones",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sincronizarUbicaciones"
  }
}