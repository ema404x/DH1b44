{
  "name": "Herencia OT por reasignaci\u00f3n de ubicaci\u00f3n (Direccion)",
  "description": "Cuando se reasigna el jefe_sitio de una Direccion en Informaci\u00f3n General, hereda autom\u00e1ticamente las OT/activos del jefe anterior al nuevo en esa ubicaci\u00f3n.",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"jefe_sitio\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Direccion"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "herencia_ot_por_reasignaci_n_de_ubicaci_n_direccion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "heredarOTsPorUbicacion",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "heredarOTsPorUbicacion"
  }
}