{
  "name": "LocationQR",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la ubicaci\u00f3n (ej: Obra Norte, Dep\u00f3sito Central)"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n adicional"
    },
    "address": {
      "type": "string",
      "description": "Direcci\u00f3n f\u00edsica"
    },
    "project_id": {
      "type": "string",
      "description": "Proyecto asociado"
    },
    "project_name": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "entrada",
        "salida",
        "ambos"
      ],
      "default": "ambos",
      "description": "Tipo de fichaje que permite"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "color": {
      "type": "string",
      "default": "blue",
      "description": "Color identificador"
    },
    "latitude": {
      "type": "number",
      "description": "Latitud GPS de la ubicaci\u00f3n"
    },
    "longitude": {
      "type": "number",
      "description": "Longitud GPS de la ubicaci\u00f3n"
    },
    "total_scans": {
      "type": "number",
      "default": 0,
      "description": "Total de escaneos registrados"
    },
    "assigned_employees": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nombres de empleados/cuadrilla asignados a esta ubicaci\u00f3n"
    },
    "jefe_sitio": {
      "type": "string",
      "description": "Nombre del jefe de sitio responsable de esta ubicaci\u00f3n. Asignaci\u00f3n manual editable desde la gesti\u00f3n de ubicaciones."
    },
    "jefe_sitio_email": {
      "type": "string",
      "description": "Email del jefe de sitio responsable. Usado por RLS para que el jefe vea y gestione \u00fanicamente sus ubicaciones y sus fichajes."
    },
    "sector_id": {
      "type": "string",
      "description": "Sector/unidad de negocio. A\u00edsla datos entre sectores. Se estampa desde el creador; sin default."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "gerente"
              }
            },
            {
              "data.jefe_sitio_email": "{{user.email}}"
            },
            {
              "data.assigned_employees": {
                "$in": [
                  "{{user.id}}",
                  "{{user.full_name}}"
                ]
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "gerente"
              }
            },
            {
              "data.jefe_sitio_email": "{{user.email}}"
            },
            {
              "data.assigned_employees": {
                "$in": [
                  "{{user.id}}",
                  "{{user.full_name}}"
                ]
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}