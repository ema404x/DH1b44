{
  "name": "DireccionMapa",
  "type": "object",
  "properties": {
    "jefe_sitio": {
      "type": "string",
      "description": "Nombre del jefe de sitio responsable"
    },
    "comuna": {
      "type": "string",
      "enum": [
        "COMUNA 8A1",
        "COMUNA 8B1",
        "COMUNA 10A1"
      ],
      "description": "Comuna de CABA"
    },
    "direccion": {
      "type": "string",
      "description": "Direcci\u00f3n completa"
    },
    "cant_escuelas": {
      "type": "number",
      "default": 0,
      "description": "Cantidad de escuelas en esta direcci\u00f3n"
    },
    "lat": {
      "type": "number",
      "description": "Latitud GPS"
    },
    "lng": {
      "type": "number",
      "description": "Longitud GPS"
    },
    "sector_id": {
      "type": "string",
      "description": "Sector/unidad de negocio. A\u00edsla datos entre sectores. Se estampa desde el creador; sin default."
    }
  },
  "required": [
    "jefe_sitio",
    "comuna",
    "direccion"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.jefe_sitio": "{{user.full_name}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}