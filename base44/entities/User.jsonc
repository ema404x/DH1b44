{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "gerente"
      ],
      "default": "user"
    },
    "sector_id": {
      "type": "string",
      "description": "Sector/unidad de negocio del usuario. A\u00edsla los datos entre sectores. Se sincroniza desde el Employee al iniciar sesi\u00f3n (vincularEmpleado). Sin default \u2014 los usuarios nuevos nacen sin sector_id y la funci\u00f3n lo estampa en el primer login. Para gerente_general cambia v\u00eda cambiarSectorActivo. Valor libre definido en la entidad Sector."
    },
    "sector_base": {
      "type": "string",
      "description": "Sector de origen del gerente_general. Se fija la primera vez que cambia de sector (cambiarSectorActivo). Permite identificar el sector propio en el dropdown (estrella)."
    },
    "can_delete_pendientes": {
      "type": "boolean",
      "default": false,
      "description": "Habilita al usuario a eliminar pendientes SAP"
    },
    "ultimo_aviso_ot_miercoles": {
      "type": "string",
      "format": "date",
      "description": "Fecha local de Buenos Aires del \u00faltimo aviso semanal de \u00f3rdenes de trabajo mostrado al usuario. Evita repetirlo al abrir DH1 desde otra PC."
    },
    "ultimo_push_ot_fecha": {
      "type": "string",
      "format": "date",
      "description": "Fecha local de Buenos Aires del \u00faltimo env\u00edo push semanal de OTs al usuario. Evita duplicados por fecha."
    },
    "offline_habilitado": {
      "type": "boolean",
      "default": false,
      "description": "Modo sin conexi\u00f3n (beta). Si es true, el dispositivo guarda la sesi\u00f3n y los datos para leerlos sin red. Apagado por defecto: la app se comporta igual que siempre."
    },
    "panel_rapido": {
      "type": "boolean",
      "default": false,
      "description": "Panel r\u00e1pido (beta). Si es true, el Dashboard pide un resumen ya calculado en el servidor (getDashboardSummary) en lugar de las listas completas. Apagado por defecto: el Dashboard se comporta igual que siempre."
    },
    "ordenes_rapidas": {
      "type": "boolean",
      "default": false,
      "description": "\u00d3rdenes r\u00e1pidas (beta). Si es true, la pantalla de \u00d3rdenes usa getWorkOrdersBoard (campos de tablero + solo cambios desde la \u00faltima visita) en lugar de getWorkOrdersForUser. Apagado por defecto: \u00d3rdenes se comporta igual que siempre."
    }
  },
  "required": [],
  "rls": {
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}