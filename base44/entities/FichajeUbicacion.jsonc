{
  "name": "FichajeUbicacion",
  "type": "object",
  "properties": {
    "location_qr_id": {
      "type": "string",
      "description": "FK a LocationQR. Identifica la ubicaci\u00f3n donde se fich\u00f3."
    },
    "location_name": {
      "type": "string",
      "description": "Nombre de la ubicaci\u00f3n (denormalizado para reportes sin join)."
    },
    "operario_nombre": {
      "type": "string",
      "description": "Nombre y apellido ingresado manualmente por el operario en el momento del fichaje."
    },
    "dni": {
      "type": "string",
      "description": "DNI del operario (solo d\u00edgitos). Ingresado manualmente al fichar. Usado como clave de matching para entrada/salida."
    },
    "entrada_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora exacta de entrada."
    },
    "entrada_signature_url": {
      "type": "string",
      "description": "URL de la firma digital capturada en la entrada."
    },
    "entrada_latitude": {
      "type": "number",
      "description": "Latitud GPS al momento de la entrada (opcional)."
    },
    "entrada_longitude": {
      "type": "number",
      "description": "Longitud GPS al momento de la entrada (opcional)."
    },
    "salida_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora exacta de salida. Null mientras la jornada est\u00e1 abierta."
    },
    "salida_signature_url": {
      "type": "string",
      "description": "URL de la firma digital capturada en la salida."
    },
    "salida_latitude": {
      "type": "number",
      "description": "Latitud GPS al momento de la salida (opcional)."
    },
    "salida_longitude": {
      "type": "number",
      "description": "Longitud GPS al momento de la salida (opcional)."
    },
    "estado": {
      "type": "string",
      "enum": [
        "abierta",
        "cerrada"
      ],
      "default": "abierta",
      "description": "abierta = entrada registrada sin salida; cerrada = jornada completa con salida."
    },
    "estado_admin": {
      "type": "string",
      "enum": [
        "pendiente",
        "revisado",
        "incidencia"
      ],
      "default": "pendiente",
      "description": "Estado administrativo del fichaje. pendiente = sin revisar; revisado = verificado OK; incidencia = reportado con problema. No altera las marcas horarias ni las firmas."
    },
    "notas_admin": {
      "type": "string",
      "description": "Notas administrativas (ej: motivo de incidencia o aclaraci\u00f3n)."
    },
    "revisado_por": {
      "type": "string",
      "description": "Nombre del usuario que cambi\u00f3 el estado administrativo por \u00faltima vez."
    },
    "fecha_revision": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora del \u00faltimo cambio de estado administrativo."
    },
    "jefe_sitio_email": {
      "type": "string",
      "description": "Email del jefe de sitio de la ubicaci\u00f3n (denormalizado de LocationQR al crear el fichaje). Permite que el jefe vea los fichajes de sus ubicaciones v\u00eda RLS."
    },
    "device_info": {
      "type": "string",
      "description": "Info del dispositivo desde el que se fich\u00f3 (user agent)."
    },
    "sector_id": {
      "type": "string",
      "description": "Sector de la ubicaci\u00f3n (heredado de LocationQR). A\u00edsla los fichajes entre sectores."
    }
  },
  "required": [
    "location_qr_id",
    "operario_nombre",
    "entrada_timestamp",
    "estado"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "gerente"
              }
            },
            {
              "data.jefe_sitio_email": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "gerente"
              }
            },
            {
              "data.jefe_sitio_email": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}