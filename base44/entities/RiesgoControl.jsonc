{
  "name": "RiesgoControl",
  "type": "object",
  "properties": {
    "sector": {
      "type": "string",
      "enum": [
        "EDUCACION",
        "SALUD",
        "BAPRO"
      ],
      "description": "Sector / contrato al que pertenece el riesgo (campo legacy, se conserva como respaldo)"
    },
    "sector_id": {
      "type": "string",
      "description": "Sector/unidad de negocio. A\u00edsla datos entre sectores. Se estampa desde el creador; sin default."
    },
    "numero": {
      "type": "number",
      "description": "N\u00famero de \u00edtem"
    },
    "evento_riesgo": {
      "type": "string",
      "description": "Descripci\u00f3n del evento o riesgo"
    },
    "probabilidad": {
      "type": "string",
      "enum": [
        "Muy Alta",
        "Alta",
        "Media",
        "Baja",
        "Muy baja"
      ],
      "description": "Probabilidad de ocurrencia"
    },
    "consecuencia": {
      "type": "string",
      "enum": [
        "Maxima",
        "Mayor",
        "Moderada",
        "Menor",
        "Minima"
      ],
      "description": "Nivel de consecuencia"
    },
    "nivel_riesgo": {
      "type": "number",
      "description": "Nivel num\u00e9rico de riesgo (probabilidad \u00d7 consecuencia)"
    },
    "metodo_control": {
      "type": "string",
      "description": "M\u00e9todo de control aplicado (MP/MC/MT)"
    },
    "frecuencia": {
      "type": "string",
      "description": "Frecuencia establecida de control"
    },
    "en_alcance": {
      "type": "string",
      "description": "Si se encuentra dentro del alcance del contrato"
    },
    "comentarios": {
      "type": "string",
      "description": "Comentarios adicionales"
    },
    "estado": {
      "type": "string",
      "enum": [
        "activo",
        "en_control",
        "resuelto"
      ],
      "default": "activo"
    }
  },
  "required": [
    "sector",
    "evento_riesgo",
    "probabilidad",
    "consecuencia"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "gerente"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "gerente"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}