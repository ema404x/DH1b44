{
  "name": "Informe",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string"
    },
    "codigo": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "avance_obra",
        "inspeccion",
        "mantenimiento",
        "financiero",
        "seguridad",
        "final",
        "otro"
      ],
      "default": "avance_obra"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "en_preparacion",
        "enviado",
        "aprobado",
        "rechazado",
        "vencido"
      ],
      "default": "pendiente"
    },
    "prioridad": {
      "type": "string",
      "enum": [
        "baja",
        "media",
        "alta",
        "urgente"
      ],
      "default": "media"
    },
    "proyecto_nombre": {
      "type": "string"
    },
    "cliente_nombre": {
      "type": "string"
    },
    "responsable": {
      "type": "string"
    },
    "fecha_limite": {
      "type": "string",
      "format": "date"
    },
    "fecha_envio": {
      "type": "string",
      "format": "date"
    },
    "fecha_aprobacion": {
      "type": "string",
      "format": "date"
    },
    "descripcion": {
      "type": "string"
    },
    "observaciones": {
      "type": "string"
    },
    "requiere_firma": {
      "type": "boolean",
      "default": false
    },
    "firma_obtenida": {
      "type": "boolean",
      "default": false
    },
    "archivo_url": {
      "type": "string"
    },
    "sector_id": {
      "type": "string",
      "description": "Sector/unidad de negocio. A\u00edsla datos entre sectores. Se estampa desde el creador; sin default."
    }
  },
  "required": [
    "titulo",
    "tipo",
    "estado"
  ],
  "rls": {
    "create": {},
    "read": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.responsable": "{{user.full_name}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.responsable": "{{user.full_name}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}