{
  "name": "MovimientoPanol",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "entrada",
        "salida"
      ],
      "description": "Tipo de movimiento"
    },
    "material_id": {
      "type": "string",
      "description": "ID del material"
    },
    "material_nombre": {
      "type": "string",
      "description": "Nombre del material (desnormalizado)"
    },
    "material_codigo": {
      "type": "string",
      "description": "C\u00f3digo del material (desnormalizado)"
    },
    "material_unidad": {
      "type": "string",
      "description": "Unidad del material"
    },
    "cantidad": {
      "type": "number",
      "description": "Cantidad del movimiento"
    },
    "stock_anterior": {
      "type": "number",
      "description": "Stock antes del movimiento"
    },
    "stock_nuevo": {
      "type": "number",
      "description": "Stock despu\u00e9s del movimiento"
    },
    "proyecto_id": {
      "type": "string",
      "description": "ID del proyecto (para salidas)"
    },
    "proyecto_nombre": {
      "type": "string",
      "description": "Nombre del proyecto (para salidas)"
    },
    "motivo": {
      "type": "string",
      "enum": [
        "compra",
        "devolucion",
        "ajuste_entrada",
        "asignacion_proyecto",
        "consumo",
        "perdida",
        "ajuste_salida"
      ],
      "description": "Motivo del movimiento"
    },
    "responsable": {
      "type": "string",
      "description": "Nombre del responsable"
    },
    "remito": {
      "type": "string",
      "description": "N\u00famero de remito o referencia"
    },
    "costo_unitario": {
      "type": "number",
      "description": "Costo unitario al momento del movimiento"
    },
    "notas": {
      "type": "string"
    },
    "sector_id": {
      "type": "string",
      "description": "Sector/unidad de negocio. A\u00edsla datos entre sectores. Se estampa desde el creador; sin default."
    }
  },
  "required": [
    "tipo",
    "material_id",
    "cantidad",
    "motivo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "gerente"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "gerente"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}