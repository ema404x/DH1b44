{
  "name": "Asset",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del activo/equipo"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo interno (clave de unicidad para import/dedup)"
    },
    "type": {
      "type": "string",
      "enum": [
        "equipo_electrico",
        "equipo_mecanico",
        "instalacion_hvac",
        "instalacion_sanitaria",
        "estructura",
        "vehiculo",
        "herramienta",
        "sistemas_informaticos",
        "mobiliario",
        "seguridad",
        "otro"
      ],
      "default": "otro"
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "serial_number": {
      "type": "string"
    },
    "location_id": {
      "type": "string",
      "description": "FK a Edificio/LocationData del mapa. Sede donde se encuentra el activo."
    },
    "location": {
      "type": "string",
      "description": "Ubicaci\u00f3n f\u00edsica detallada del activo (texto auxiliar)"
    },
    "sede": {
      "type": "string",
      "description": "Nombre de la sede/edificio (denormalizado de location_id para b\u00fasqueda y BAPRO)"
    },
    "area": {
      "type": "string",
      "description": "\u00c1rea/zona/departamento dentro de la sede"
    },
    "jefe_sitio": {
      "type": "string",
      "description": "Responsable de mantenimiento del activo"
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "operativo",
        "en_mantenimiento",
        "fuera_de_servicio",
        "baja"
      ],
      "default": "operativo"
    },
    "criticality": {
      "type": "string",
      "enum": [
        "baja",
        "media",
        "alta",
        "critica"
      ],
      "default": "media"
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    },
    "warranty_expiry": {
      "type": "string",
      "format": "date"
    },
    "last_maintenance": {
      "type": "string",
      "format": "date"
    },
    "next_maintenance": {
      "type": "string",
      "format": "date"
    },
    "maintenance_frequency_days": {
      "type": "number",
      "default": 90
    },
    "purchase_cost": {
      "type": "number"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visto_bapro": {
      "type": "boolean",
      "default": false,
      "description": "Marcado por el banco (BAPRO) v\u00eda link compartido. Booleano global: true si fue visto en alg\u00fan mes. Para granularidad mes a mes ver vistos_bapro_meses."
    },
    "visto_bapro_fecha": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora del \u00faltimo visto BAPRO ( backward-compat)"
    },
    "visto_bapro_por": {
      "type": "string",
      "description": "Token de la sesi\u00f3n de revisi\u00f3n BAPRO que marc\u00f3 el \u00faltimo visto"
    },
    "visto_bapro_lote": {
      "type": "string",
      "description": "Mes del \u00faltimo lote de revisi\u00f3n BAPRO ( backward-compat)"
    },
    "vistos_bapro_meses": {
      "type": "object",
      "description": "Hist\u00f3rico de revisiones BAPRO por mes. Clave=YYYY-MM (mes_periodo del token), valor={fecha, por}. Permite revisi\u00f3n mes a mes sin perder hist\u00f3rico ni sobrescribir meses previos.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date-time"
          },
          "por": {
            "type": "string"
          }
        }
      }
    },
    "sector_id": {
      "type": "string",
      "description": "Sector/unidad de negocio. A\u00edsla datos entre sectores. Se estampa desde el creador; sin default."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "gerente"
              }
            },
            {
              "user_condition": {
                "role": "jefe_sitio"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "gerente"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}