{
  "name": "PendienteHistorial",
  "type": "object",
  "properties": {
    "pendiente_id": {
      "type": "string",
      "description": "ID del pendiente relacionado"
    },
    "pendiente_numero_sap": {
      "type": "string",
      "description": "N\u00b0 SAP del pendiente (desnormalizado para b\u00fasqueda)"
    },
    "usuario_email": {
      "type": "string",
      "description": "Email del usuario que realiz\u00f3 el cambio"
    },
    "usuario_nombre": {
      "type": "string",
      "description": "Nombre del usuario"
    },
    "estado_anterior": {
      "type": "string",
      "enum": [
        "pendiente",
        "asignado",
        "en_progreso",
        "resuelto",
        "cancelado"
      ],
      "description": "Estado anterior al cambio"
    },
    "estado_nuevo": {
      "type": "string",
      "enum": [
        "pendiente",
        "asignado",
        "en_progreso",
        "resuelto",
        "cancelado"
      ],
      "description": "Nuevo estado"
    },
    "comentario": {
      "type": "string",
      "description": "Comentario o nota del usuario sobre el cambio"
    },
    "campos_modificados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de campos que cambiaron adem\u00e1s del estado"
    },
    "jefe_sitio_anterior": {
      "type": "string"
    },
    "jefe_sitio_nuevo": {
      "type": "string"
    },
    "sector_id": {
      "type": "string",
      "description": "Sector/unidad de negocio. A\u00edsla datos entre sectores. Se estampa desde el creador; sin default."
    }
  },
  "required": [
    "pendiente_id",
    "usuario_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_sitio"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}