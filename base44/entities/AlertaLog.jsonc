{
  "name": "AlertaLog",
  "type": "object",
  "properties": {
    "config_id": {
      "type": "string",
      "description": "ID de la AlertaConfig que la gener\u00f3"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "garantia_activo",
        "stock_material",
        "pendiente_vencido",
        "ot_vencida"
      ]
    },
    "nivel": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "warning"
    },
    "titulo": {
      "type": "string"
    },
    "mensaje": {
      "type": "string"
    },
    "entidad_tipo": {
      "type": "string",
      "description": "Tipo de entidad afectada (Asset, Material, Pendiente, WorkOrder)"
    },
    "entidad_id": {
      "type": "string"
    },
    "entidad_nombre": {
      "type": "string"
    },
    "email_enviado": {
      "type": "boolean",
      "default": false
    },
    "leida": {
      "type": "boolean",
      "default": false
    },
    "fecha_alerta": {
      "type": "string",
      "format": "date-time"
    },
    "sector_id": {
      "type": "string",
      "description": "Sector/unidad de negocio. A\u00edsla los logs entre sectores. Se estampa al generar la alerta desde el sector de la config origen; sin default."
    }
  },
  "required": [
    "tipo",
    "titulo",
    "mensaje"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "gerente"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "gerente"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}