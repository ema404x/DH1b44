{
  "name": "ForoRespuesta",
  "type": "object",
  "properties": {
    "hilo_id": {
      "type": "string",
      "description": "ID del ForoHilo al que pertenece"
    },
    "cuerpo": {
      "type": "string",
      "description": "Contenido de la respuesta"
    },
    "autor_nombre": {
      "type": "string"
    },
    "autor_id": {
      "type": "string"
    },
    "adjuntos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "imagen",
              "archivo"
            ]
          }
        }
      }
    },
    "reacciones": {
      "type": "object",
      "description": "Mapa emoji -> array de user IDs",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "menciones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "responde_a_id": {
      "type": "string",
      "description": "ID de ForoRespuesta si es un reply"
    },
    "responde_a_autor": {
      "type": "string"
    },
    "sector_id": {
      "type": "string",
      "description": "Sector/unidad de negocio. A\u00edsla datos entre sectores. Se estampa desde el creador; sin default."
    }
  },
  "required": [
    "hilo_id",
    "cuerpo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "jefe_sitio"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "gerente"
              }
            },
            {
              "user_condition": {
                "role": "jefe_sitio"
              }
            },
            {
              "user_condition": {
                "role": "user"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}