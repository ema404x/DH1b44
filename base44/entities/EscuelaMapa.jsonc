{
  "name": "EscuelaMapa",
  "type": "object",
  "properties": {
    "direccion_mapa_id": {
      "type": "string",
      "description": "ID de la DireccionMapa relacionada"
    },
    "nombre": {
      "type": "string",
      "description": "Nombre del establecimiento/escuela"
    },
    "jefe_sitio": {
      "type": "string",
      "description": "Nombre del jefe de sitio (desnormalizado)"
    },
    "comuna": {
      "type": "string",
      "description": "Comuna (desnormalizado)"
    },
    "sector_id": {
      "type": "string",
      "description": "Sector/unidad de negocio. A\u00edsla datos entre sectores. Se estampa desde el creador; sin default."
    }
  },
  "required": [
    "direccion_mapa_id",
    "nombre"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.jefe_sitio": "{{user.full_name}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.sector_id": "{{user.data.sector_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}